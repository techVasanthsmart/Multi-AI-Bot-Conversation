# Multi-AI Bot Conversation - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# API Keys
# ============================================

# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# Model Configuration
# ============================================

# OpenAI Model
# Free tier options: gpt-3.5-turbo (has free tier)
# Low cost: gpt-4o-mini (~.15/1M tokens)
# Enhanced: gpt-4o, gpt-4-turbo, gpt-4
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Model
# Free tier: gemini-2.0-flash-exp (generous free tier)
# Enhanced: gemini-2.0-flash-thinking-exp-0019, gemini-pro
GOOGLE_MODEL=gemini-2.0-flash-exp

# OpenRouter Model
# Free: deepseek/deepseek-r1-0528:free (already free)
# Enhanced: anthropic/claude-3.5-sonnet, openai/gpt-4o, google/gemini-pro-1.5
OPENROUTER_MODEL=deepseek/deepseek-r1-0528:free

# Groq Model
# Free tier: llama-3.1-8b-instant, mixtral-8x7b-32768
# Enhanced: Latest models with higher context windows
GROQ_MODEL=llama-3.1-8b-instant

# ============================================
# Notes
# ============================================
# - All models above are configured for zero-cost or minimal cost operation
# - For more interesting/crazy conversations, try upgrading to paid/latest models
# - See README.md for detailed model recommendations and cost considerations
